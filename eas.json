{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "offline-test": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "APP_VARIANT": "offline-test",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SUPABASE_URL": "",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": ""
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
